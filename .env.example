# Copy this file to .env and fill in real values. Never commit .env.

# Parallel Web SDK
PARALLEL_API_KEY=

# Watchmode API
WATCHMODE_API_KEY=

# TMDB API
TMDB_API_KEY=

# Google Cloud / Vertex AI (Agent Engine, ADK)
# GOOGLE_GENAI_USE_VERTEXAI=True routes google-genai (used under the ADK) to
# Vertex AI rather than the direct Gemini API key path; confirmed by reading
# google/genai/_api_client.py in the installed package.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
